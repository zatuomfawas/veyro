// Veyro — production data model.
//
// Scope: founder-centric. Everything hangs off User (the founder), not off a
// Business. Business, LedgerEntry, Payout, PaymentAccount and
// GuardianRelationship were removed in this pivot; git history has the old
// business-scoped shape if it is ever needed.
//
// Two rules this schema exists to enforce:
//   1. Money is stored as integer minor units, always paired with a currency.
//      There is no Float or Decimal column for an amount anywhere in this file,
//      and there never should be.
//   2. A balance is never stored. It is folded from FounderTransaction +
//      FounderPayoutRequest. There is deliberately no `balance` column.

// Prisma 7: the generator must name an output path, and the connection URL
// lives in prisma.config.ts rather than here. Do not add `url` back to the
// datasource block; Prisma 7 rejects the schema if you do.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- identity

enum Role {
  FOUNDER
  GUARDIAN
  ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  /// Null until the address is proved. Signin refuses a null, which is what
  /// stops someone registering as an address they do not control and then
  /// accepting a guardian invitation sent to it.
  emailVerifiedAt DateTime?

  /// SHA-256 of the verification token, never the token itself, the same
  /// pattern as Session.tokenHash and GuardianConsent.tokenHash. If the
  /// database leaks, nothing in it can be used to verify as anyone.
  emailVerificationTokenHash String? @unique

  /// One-time tokens still need a clock. 24 hours.
  emailVerificationExpiresAt DateTime?
  /// SHA-256 of a password-reset token. Same hash-only rule as every other
  /// token here: a database leak must not hand anyone a working reset link.
  passwordResetTokenHash String? @unique

  /// Resets expire far faster than verification links. A reset link is a way
  /// into the account, so an hour is the window; a verification link only
  /// proves an address and can afford a day.
  passwordResetExpiresAt DateTime?

  passwordHash    String? // argon2id. Null when SSO-only.
  totpSecret      String? // encrypted at rest, never returned by any API
  name            String
  role            Role
  dateOfBirth     DateTime? // founders only; drives the eligibility branch
  countryCode     String    @db.Char(2)
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  sessions      Session[]
  notifications Notification[]
  auditEvents   AuditEvent[]

  products       FounderProduct[]       @relation("FounderProducts")
  transactions   FounderTransaction[]   @relation("FounderTransactions")
  checkoutViews  CheckoutView[]         @relation("FounderCheckoutViews")
  payoutRequests FounderPayoutRequest[] @relation("FounderPayoutRequests")
  paymentAccount FounderPaymentAccount? @relation("FounderPaymentAccount")
  monthlyLedgers MonthlyLedger[]        @relation("FounderMonthlyLedgers")
  disputes       FounderDispute[]       @relation("FounderDisputes")
  healthReviews  HealthReviewDraft[]    @relation("FounderHealthReviews")

  // A user is the founder in some consents and the guardian in others, so both
  // directions are named.
  consentsReceived GuardianConsent[] @relation("FounderConsents")
  consentsGiven    GuardianConsent[] @relation("GuardianConsents")

  @@index([email])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // only the hash is stored
  ipHash    String? // hashed, for anomaly detection, not for display
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, expiresAt])
}

// ---------------------------------------------------------------- products

enum ProductStatus {
  DRAFT
  LIVE
  ARCHIVED
}

model FounderProduct {
  id          String @id @default(cuid())
  founderId   String
  founder     User   @relation("FounderProducts", fields: [founderId], references: [id], onDelete: Cascade)
  name        String
  description String

  // Minor units, per rule 1. Currency is mandatory alongside it: a minor-unit
  // integer is meaningless on its own, since JPY has no minor unit at all and
  // 1000 is either ¥1000 or $10.00 depending which it is.
  priceMinor     Int           @default(0)
  currency       String        @default("USD") @db.Char(3)
  priceRecurring Boolean       @default(false)
  status         ProductStatus @default(DRAFT)
  createdAt      DateTime      @default(now())

  transactions FounderTransaction[]
  views        CheckoutView[]

  @@index([founderId, status])
}

// -------------------------------------------------------------- checkout views

/// One row per product per day, holding a count.
///
/// Not one row per view. A checkout page can be opened far more often than it
/// is paid, and storing every hit would grow without bound to answer a question
/// nobody asks at that resolution: the dashboard reports days, so days are what
/// is stored. An upsert per view keeps this to one row per product per day
/// forever.
///
/// What a "view" is, exactly, because the conversion rate depends on it: one
/// browser session opening one product's checkout page. Reloads inside the same
/// session are not counted again, so the denominator is closer to "people who
/// looked" than "pages served". It is recorded from the browser rather than
/// during render, which keeps prefetches, crawlers and Next's own re-renders
/// out of the number.
///
/// No visitor identity is stored, here or anywhere: dedupe uses sessionStorage
/// in the customer's own browser and nothing crosses the wire but the product.
model CheckoutView {
  id        String         @id @default(cuid())
  founderId String
  founder   User           @relation("FounderCheckoutViews", fields: [founderId], references: [id], onDelete: Cascade)
  productId String
  // Cascade, unlike FounderTransaction: a view count is not a record of money
  // and nothing is owed to anyone if it goes when its product does.
  product   FounderProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Midnight UTC of the day counted. Date, not timestamp: the grain IS a day,
  /// and a time component would let two rows exist for one day.
  day   DateTime @db.Date
  count Int      @default(0)

  @@unique([productId, day])
  @@index([founderId, day])
}

// ---------------------------------------------------------------- money in

enum FounderTransactionStatus {
  PENDING
  COMPLETED
  REFUNDED
}

model FounderTransaction {
  id        String @id @default(cuid())
  founderId String
  founder   User   @relation("FounderTransactions", fields: [founderId], references: [id], onDelete: Cascade)
  productId String

  // Restrict, not Cascade: deleting a product must never delete the record of
  // money that moved because of it. Archive the product instead.
  product FounderProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Gross: what the customer paid, before anything is deducted.
  amountMinor Int

  /// Stripe's processing fee, in the same currency, read from the charge's
  /// balance transaction on the connected account. Null means Stripe had not
  /// settled the balance transaction when the webhook arrived, which happens
  /// with asynchronous payment methods. Null is displayed as "not yet known"
  /// rather than as zero: a missing fee and a zero fee are different facts.
  feeMinor Int?

  /// What has been sent back to the customer on this payment, cumulative.
  /// Partial refunds are normal, so this is an amount rather than a flag; the
  /// REFUNDED status means fully refunded and is derived from it.
  refundedMinor Int @default(0)

  /// Lost to a dispute, cumulative. Separate from refundedMinor because a
  /// chargeback is not a refund: the money leaves the same way but the cause,
  /// the fee treatment and what we tell the founder all differ.
  disputedMinor Int @default(0)

  /// The USD value of `amountMinor`, fixed when the payment settled.
  ///
  /// Qualifying Monthly Earnings are denominated in USD (Terms, "Currency"),
  /// so a non-USD payment has to be converted once and then never again. The
  /// rate is Stripe's own for this transaction, read from the balance
  /// transaction, and is stored beside the figure it produced so an invoice
  /// can be reconstructed years later without asking what the rate was.
  ///
  /// Null while the balance transaction has not settled. For USD payments the
  /// rate is null and this equals amountMinor.
  usdAmountMinor Int?
  exchangeRate   Decimal? @db.Decimal(20, 10)

  currency    String                   @default("USD") @db.Char(3)
  status      FounderTransactionStatus @default(PENDING)

  // The PaymentIntent, not the webhook event. One payment is one row: a single
  // payment emits several events (payment_intent.succeeded, charge.succeeded,
  // charge.updated...), so keying on event id would let one charge post twice
  // under two different ids. Webhook replay is deduped separately, by
  // WebhookEvent[provider, providerRef].
  stripePaymentIntentId String   @unique
  createdAt             DateTime @default(now())

  @@index([founderId, createdAt])
  @@index([founderId, status])
  @@index([productId])
}

// ---------------------------------------------------------------- money out

enum PayoutRequestStatus {
  REQUESTED
  APPROVED
  SENT
  FAILED
}

model FounderPayoutRequest {
  id          String              @id @default(cuid())
  founderId   String
  founder     User                @relation("FounderPayoutRequests", fields: [founderId], references: [id], onDelete: Cascade)
  amountMinor Int
  currency    String              @default("USD") @db.Char(3)
  status      PayoutRequestStatus @default(REQUESTED)
  createdAt   DateTime            @default(now())

  @@index([founderId, status])
  @@index([founderId, createdAt])
}

// ---------------------------------------------------------------- guardianship

// One row per founder. The invite half is the same pattern the old
// GuardianRelationship used, because it is the part that has to be secure: the
// founder invites an adult by email, a single-use token is hashed here and the
// raw value only ever exists in the invite, and the adult becomes the guardian
// of record only by presenting it.
//
// No status enum — the timestamps say it unambiguously:
//   respondedAt null                  -> still pending
//   respondedAt set, consentedAt null -> declined
//   consentedAt set                   -> consented
//   expiresAt null                    -> the consent does not expire
model GuardianConsent {
  id        String @id @default(cuid())
  founderId String @unique
  founder   User   @relation("FounderConsents", fields: [founderId], references: [id], onDelete: Cascade)

  // Null until the invited adult accepts.
  guardianId String?
  guardian   User?   @relation("GuardianConsents", fields: [guardianId], references: [id], onDelete: SetNull)

  invitedEmail    String
  tokenHash       String   @unique // single-use, hashed; raw token only in the invite
  invitedAt       DateTime @default(now())
  inviteExpiresAt DateTime

  respondedAt DateTime?
  consentedAt DateTime?
  expiresAt   DateTime?

  // Set when the invited adult opens a dead link and asks for a fresh one.
  // Without this the request has nowhere to live: an expired invite left the
  // guardian with nothing to do but chase the founder by text, and the founder
  // with no idea they were waiting. Cleared whenever a new invite is sent,
  // because the request has then been answered.
  newLinkRequestedAt DateTime?

  @@index([invitedEmail])
}

// ---------------------------------------------------------------- payments

enum AccountStatus {
  NOT_STARTED
  AWAITING_GUARDIAN
  PENDING
  REQUIREMENTS_DUE
  ACTIVE
  RESTRICTED
  DISCONNECTED
}

model FounderPaymentAccount {
  id        String @id @default(cuid())
  founderId String @unique
  founder   User   @relation("FounderPaymentAccount", fields: [founderId], references: [id], onDelete: Cascade)

  provider          ProviderId
  providerAccountId String?       @unique // the connected account id at the processor
  status            AccountStatus @default(NOT_STARTED)

  // The adult who passes the processor's checks — the guardian. Veyro stores
  // the reference, never the documents: identity files go straight to the
  // processor's own hosted form.
  representativeUserId String?
  requirementsDue      Json    @default("[]")

  connectedAt    DateTime?
  disconnectedAt DateTime?
  updatedAt      DateTime  @updatedAt
}

// ---------------------------------------------------------------- plumbing

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  routeName String?
  routeId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Append-only. No update or delete path exists in application code.
model AuditEvent {
  id        String  @id @default(cuid())
  actorId   String? // null means the payment provider acted
  actor     User?   @relation(fields: [actorId], references: [id])
  founderId String? // was businessId before the pivot; scope is the founder now
  action    String // "payout.requested", "guardian.consented", ...
  target    String
  metadata  Json    @default("{}")
  ipHash    String?

  createdAt DateTime @default(now())

  @@index([founderId, createdAt])
}

enum ProviderId {
  SANDBOX
  STRIPE_CONNECT
  ADYEN_PLATFORMS
}

// Every processor webhook is written here before it is acted on, so a replay
// or an out-of-order delivery cannot post the same money twice.
model WebhookEvent {
  id          String     @id @default(cuid())
  provider    ProviderId
  providerRef String
  type        String
  payload     Json
  signatureOk Boolean
  processedAt DateTime?
  error       String?
  receivedAt  DateTime   @default(now())

  @@unique([provider, providerRef])
}


// ---------------------------------------------------------------- the paid tier

/// One row per connected account per calendar month. The single source of
/// truth for what a founder has earned and what Veyro has charged.
///
/// This exists because the fee is incremental: what a payment owes depends on
/// everything that came before it in the same month. Recomputing that by
/// scanning transactions on every charge would be both slow and racy, so the
/// running totals live here and the row is locked while a fee is decided.
///
/// `month` is "YYYY-MM" in UTC, keyed on the Stripe timestamp of the payment
/// (Terms, "Calendar month"). Never local time: a payment at 23:30 in Dubai
/// on the 31st belongs to the month UTC says it does.
model MonthlyLedger {
  id        String @id @default(cuid())
  founderId String
  founder   User   @relation("FounderMonthlyLedgers", fields: [founderId], references: [id], onDelete: Cascade)

  /// "YYYY-MM", UTC.
  month String @db.Char(7)

  /// Qualifying Monthly Earnings in USD minor units: successful charges, less
  /// refunds, less disputes lost. May go down when a refund lands; never
  /// causes a fee already collected to be returned.
  qmeMinor Int @default(0)

  /// Veyro platform fees incurred this month, in USD minor units. Only ever
  /// increases. The ratchet in the Terms depends on that.
  feeCollectedMinor Int @default(0)

  /// Reserved while a charge is in flight, so two simultaneous checkouts
  /// cannot both be told they are under the threshold. Released if the
  /// payment never succeeds.
  feeReservedMinor Int @default(0)

  /// When the founder was emailed that this month passed the free limit.
  /// Set inside the same locked transaction that records the crossing, so two
  /// concurrent payments cannot both decide they were the one that crossed.
  /// Null means not yet told; it is never cleared, so a refund that drops the
  /// month back under the limit and a later payment that re-crosses it do not
  /// produce a second email about the same month.
  thresholdNotifiedAt DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([founderId, month])
  @@index([month])
}

enum DisputeState {
  NEEDS_RESPONSE
  UNDER_REVIEW
  WON
  LOST
  WARNING_CLOSED
  OTHER
}

/// A chargeback, mirrored from Stripe so we can tell somebody about it.
///
/// On Standard accounts the account holder responds in their own Stripe
/// dashboard; Veyro cannot submit evidence through the API on their behalf.
/// So this model exists to notify and to link, which is what the Terms
/// promise, and deliberately holds no evidence of its own.
model FounderDispute {
  id        String @id @default(cuid())
  founderId String
  founder   User   @relation("FounderDisputes", fields: [founderId], references: [id], onDelete: Cascade)

  stripeDisputeId String       @unique
  stripeChargeId  String
  amountMinor     Int
  currency        String       @db.Char(3)
  reason          String
  state           DisputeState @default(NEEDS_RESPONSE)

  /// Stripe's evidence deadline. Null when Stripe did not supply one.
  evidenceDueBy DateTime?

  /// Set once the founder and guardian have been told, so a replayed webhook
  /// does not email twice.
  notifiedAt DateTime?

  openedAt  DateTime @default(now())
  closedAt  DateTime?
  updatedAt DateTime @updatedAt

  @@index([founderId, state])
  @@index([founderId, openedAt])
}

enum ReviewState {
  DRAFT
  APPROVED
  SENT
  DISCARDED
}

/// A monthly account health review, drafted by a job and sent only by a human.
///
/// Counsel defines this as a human review, so the job may assemble findings
/// and may not send them. Nothing moves from DRAFT to SENT without somebody
/// approving it, and the test suite asserts that.
model HealthReviewDraft {
  id        String @id @default(cuid())
  founderId String
  founder   User   @relation("FounderHealthReviews", fields: [founderId], references: [id], onDelete: Cascade)

  /// The month reviewed, "YYYY-MM" UTC.
  month String @db.Char(7)

  /// Machine-assembled findings. A reviewer edits this before approving.
  findings Json

  /// What the reviewer decided to say. Null until they have written it.
  summary String?

  state      ReviewState @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  sentAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([founderId, month])
  @@index([state])
}
