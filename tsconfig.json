{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // scripts/*.test.ts are run by `node --test`, which strips types but does
    // not resolve extensions, so their imports must name the .ts file. tsc
    // rejects that unless this is on, and this is only legal because noEmit is
    // true above. The alternative was excluding scripts/ from the project,
    // which would leave the tests unchecked — the opposite of the point.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // The SDK is its own package with its own tsconfig, its own
    // dependencies and its own typecheck. Leaving it in here made the
    // app's build type-check packages/sdk/tsup.config.ts, whose tsup
    // import is a devDependency that only exists once you have run
    // npm install inside that package — true on my machine, false on a
    // clean build, which is exactly the shape of failure that only
    // shows up in CI.
    "packages"
  ]
}
